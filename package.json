{
  "name": "yue-workbench",
  "private": true,
  "version": "10.0.0",
  "type": "module",
  "description": "像素森系个人工作台 PWA —— 天地通，年月通，日事通，万事皆成！",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vapid": "node scripts/gen-vapid.mjs",
    "icons": "python scripts/gen-icons.py",
    "size": "node scripts/report-size.mjs",
    "check:date": "esbuild scripts/check-date.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-date.mjs --log-level=error && node node_modules/.cache/check-date.mjs",
    "check:rules": "esbuild scripts/check-rules.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-rules.mjs --log-level=error && node node_modules/.cache/check-rules.mjs",
    "check:ielts": "esbuild scripts/check-ielts.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-ielts.mjs --log-level=error && node node_modules/.cache/check-ielts.mjs",
    "check:subtitle": "esbuild scripts/check-subtitle.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-subtitle.mjs --log-level=error && node node_modules/.cache/check-subtitle.mjs",
    "check": "npm run typecheck && npm run check:date && npm run check:rules && npm run check:ielts && npm run check:subtitle"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
